<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="ConcurrentHashSet" />
        <PackageReference Include="FFMpegCore" />
        <PackageReference Include="Material.Icons" />
        <PackageReference Include="Serilog" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\external\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
        <ProjectReference Include="..\..\external\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <ProjectReference Include="..\FortnitePorting.CUE4Parse\FortnitePorting.CUE4Parse.csproj" />
        <ProjectReference Include="..\FortnitePorting.Shared\FortnitePorting.Shared.csproj" />
    </ItemGroup>

    <!-- the owner's private overlay, beside the repo (..\..\..\fpfork-private): its code when it's there;
         -p:MPPrivateRoot=none\ builds without it -->
    <PropertyGroup>
        <MPPrivateRoot Condition="'$(MPPrivateRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\fpfork-private\</MPPrivateRoot>
    </PropertyGroup>
    <Import Project="$(MPPrivateRoot)Exporting.props" Condition="Exists('$(MPPrivateRoot)Exporting.props')" />
</Project>
